# Copie para .env e preencha. O .env está no .gitignore.

# ─── Notion ───────────────────────────────────────────────────────────
# Use uma INTEGRAÇÃO INTERNA criada em notion.so/my-integrations — não um
# Personal Access Token. A diferença é de escopo, não de sintaxe: o PAT herda
# todo o acesso do usuário que o emitiu, sobre o workspace inteiro, enquanto a
# integração só alcança o que for explicitamente compartilhado com ela.
#
# COMPARTILHE A INTEGRAÇÃO APENAS com a página "Lumen · Central de
# Monitoramento". Mesmo assim o escopo falha ABERTO: cada página nova
# compartilhada amplia o alcance deste token sem aviso.
NOTION_TOKEN=

# ID do usuário do Notion que recebe os alertas da varredura. Sem ele os
# alertas são criados sem dono.
#
# Para que o Notion notifique de fato, este usuário precisa ser DIFERENTE de
# quem emitiu o token, e precisa ter acesso à página. Notion não notifica
# ninguém da própria ação, nem sobre página que a pessoa não enxerga.
NOTION_RESPONSAVEL_ID=

# ─── Gemini (Google AI Studio) ────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─── Supabase — autenticação e API do painel ──────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
