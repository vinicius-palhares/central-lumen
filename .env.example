# Copie para .env e preencha. O .env está no .gitignore.

# ─── Notion ───────────────────────────────────────────────────────────
# Integração interna criada em notion.so/my-integrations.
# COMPARTILHE A INTEGRAÇÃO APENAS com a página "Lumen · Central de
# Monitoramento". O escopo de integração do Notion falha ABERTO: cada página
# nova compartilhada amplia o alcance deste token sem aviso.
NOTION_TOKEN=

# ID do usuário do Notion que recebe os alertas da varredura.
# É o preenchimento deste campo que faz o Notion notificar. Sem ele os alertas
# são criados, mas ninguém é avisado.
NOTION_RESPONSAVEL_ID=

# ─── Gemini (Google AI Studio) ────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─── Supabase — autenticação e API do painel ──────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
